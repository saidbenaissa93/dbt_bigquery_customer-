table fct_sales_summary
	lineageTag: 1f7f45d7-a302-408e-8809-13c44a0c0ec3

	measure 'CA Total' = SUM(fct_sales_summary[total_sales])
		lineageTag: a6b79a9a-89f8-43de-8752-1beffe459b63

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Total' = SUM(fct_sales_summary[total_profit])
		lineageTag: 966f2df7-838b-4128-bb68-cfd190cc4fe2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Panier Moyen' = DIVIDE([CA Total], SUM(fct_sales_summary[total_transactions]), 0)
		lineageTag: dc014ce0-6280-4f75-a8b3-9a7e852b34cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Marge = DIVIDE([Profit Total], [CA Total], 0)
		lineageTag: 6d1dfae6-f72e-4f91-8bf8-b3c11d3595bc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

